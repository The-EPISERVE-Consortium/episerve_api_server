# lakeFS — credentials are loaded automatically from K8s secrets by run_local.sh
LAKEFS_URL=https://lake-episerve.zib.de
LAKEFS_RAW_REPO=data-raw
LAKEFS_PROCESSED_REPO=data-processed
LAKEFS_MODEL_RUNS_REPO=model-runs
LAKEFS_BRANCH=main

# CKAN — API token loaded automatically from K8s secrets by run_local.sh
# Use external URL for local dev; K8s deployment uses internal cluster URL
CKAN_URL=https://data.episerve.zib.de

# Prefect — no API key needed for self-hosted Prefect within the cluster
# For local dev: use external URL or port-forward (kubectl port-forward svc/prefect-server 4200:4200)
# External: https://prefect.episerve.zib.de/api
# Port-forward: http://localhost:4200/api
PREFECT_API_URL=
PREFECT_MODEL_RUNNER_DEPLOYMENT=model-runner/model-pipeline
# Optional: base URL for "Open Prefect run" links on the AI Blackboard page.
# Defaults to PREFECT_API_URL without its trailing "/api".
PREFECT_UI_URL=

# DOIP server
DOIP_URL=https://doip.episerve.zib.de

# Blackboard — password loaded automatically from K8s secrets by run_local.sh.
# Use the external LB IP for local dev; K8s deployment uses the internal
# cluster DNS name set directly in episerve-k8s/apps/episerve-api-server/deployment.yaml.
MARIADB_HOST=130.73.130.213
BLACKBOARD_DB=agent_blackboard
BLACKBOARD_USER=blackboard

# Server
PORT=8000

# Auth — credentials for POST /auth/token
# AUTH_MASTER_SECRET is server-side only; set it in the K8s sealed secret, not here
AUTH_USERNAME=
AUTH_PASSWORD=
